FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    unzip \
    php-cli \
    php-apcu \
    php-bcmath \
    php-bz2 \
    php-curl \
    php-gd \
    php-gmp \
    php-fpm \
    php-igbinary \
    php-imagick \
    php-intl \
    php-mbstring \
    php-mysql \
    php-opcache \
    php-readline \
    php-redis \
    php-soap \
    php-xml \
    php-zip \
    libmagickcore-7.q16-10-extra \
    imagemagick \
    ffmpeg \
    iproute2 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY node /usr/bin/node
RUN chmod +x /usr/bin/node

COPY run.sh /run.sh
RUN chmod +x /run.sh

CMD ["/run.sh"]
