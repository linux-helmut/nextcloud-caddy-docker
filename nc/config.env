# ==========================================
# Domains
# ==========================================

NC_DOMAIN="cloud.lokal.de"
OFFICE_DOMAIN="office.lokal.de"





# ==========================================
# Docker Netzwerk
# ==========================================

DOCKER_NETWORK="nextcloud"

# IPv4
DOCKER_IPV4_SUBNET="172.30.0.0/16"
DOCKER_IPV4_GATEWAY="172.30.0.1"

# IPv6
DOCKER_IPV6_SUBNET="fd00:172:30::/64"
DOCKER_IPV6_GATEWAY="fd00:172:30::1"





# ==========================================
# MariaDB
# ==========================================

DB_NAME="nextcloud"
DB_USER="nextcloud"
DB_PASSWORD="nextcloud"
DB_ROOT_PASSWORD="root"





# ==========================================
# PHP-FPM Image
# ==========================================

NC_IMAGE_NAME="nextcloud"
NC_IMAGE_VERSION="v1.0.2"

INSTALL_NODE26="false"






# ==========================================
# Nextcloud
# ==========================================

# Installation
NC_DB_HOST="nc_mariadb:3306"
NC_DB_TYPE="mysql"
NC_DB_PREFIX="oc_"

NC_DATA_DIR="/var/www/data"
NC_ADMIN_USER="admin"
NC_ADMIN_PASSWORD="Admin#2026"

# Allgemein
NC_SERVER_ID="5"

# SMTP
NC_MAIL_MODE="smtp"
NC_MAIL_FROM="cloud"
NC_MAIL_DOMAIN="lokal.de"
NC_MAIL_HOST="mail.lokal.de"
NC_MAIL_PORT="465"
NC_MAIL_AUTH="true"
NC_MAIL_USER="cloud@lokal.de"
NC_MAIL_PASSWORD="passwort"
NC_MAIL_SECURE="ssl"


# Standardsprache der Nextcloud-Oberfläche
# Beispiele: de_DE, en_GB, en_US, fr_FR
NC_DEFAULT_LANGUAGE="de_DE"

# Knowledge Base / Hilfe- und Wissensdatenbank aktivieren
# true = aktiviert, false = deaktiviert
NC_KNOWLEDGEBASE_ENABLED="false"

# WebAuthn-Authentifizierung aktivieren
# true = aktiviert, false = deaktiviert
NC_WEBAUTHN_ENABLED="false"

# Link für Passwort-Wiederherstellung
# disabled = deaktiviert
# email = Wiederherstellung per E-Mail
NC_LOST_PASSWORD_LINK="disabled"

# Standard-Ländercode für Telefonnummern
# Beispiele: DE, AT, CH, GB, US
NC_DEFAULT_PHONE_REGION="DE"




