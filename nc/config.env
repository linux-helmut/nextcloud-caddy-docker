# ============================================================================
# Central configuration for nextcloud-caddy-docker
#
# Copy this file to /docker/nc/config.env and adjust it before installation.
# Compose files read it with: docker compose --env-file /docker/nc/config.env ...
# Services that need the values at runtime also receive it through env_file.
#
# IMPORTANT:
# - Replace every example password/secret before using this setup.
# - Keep this file private (recommended permissions: chmod 600 config.env).
# - Do not commit real credentials to a public Git repository.
# - Values used by shell scripts are loaded with: source /docker/nc/config.env
# ============================================================================



# ----------------------------------------------------------------------------
# 1. Hostnames
# ----------------------------------------------------------------------------

# Hostname used to access Nextcloud through Caddy.
# For the default local setup, create a local DNS record pointing to this host.
NC_DOMAIN="cloud.lokal.de"

# Optional Euro-Office hostname. It is used by the Caddy configuration.
OFFICE_DOMAIN="office.lokal.de"

# TLS-Konfiguration
# Intern: "tls internal", Caddy erstellt selbst signierte Zertifikate für den internen Gebrauch.
# Öffentlich: leer lassen, Caddy nutzt ACME um hier öffentliche Zertifikate zu erstellen.
CADDY_TLS="tls internal"

# DNS Server für Docker
# Bei interner Verwendung mit eigenem DNS Server entsprechende IPs einsetzen.
DOCKER_DNS_IPV4="1.1.1.1"
DOCKER_DNS_IPV6="2606:4700:4700::1111"

# Beispiel: Interner DNS Server
#DOCKER_DNS_IPV4="10.2.0.1"
#DOCKER_DNS_IPV6="fd00::10:2:0:1"




# ----------------------------------------------------------------------------
# 2. Shared Docker network
# ----------------------------------------------------------------------------

# Name of the external Docker bridge network shared by Nextcloud services.
DOCKER_NETWORK="nc_cloud"

# IPv4 subnet and gateway assigned to the Docker bridge network.
# Choose a subnet that does not overlap with your LAN, VPN or other Docker nets.
DOCKER_IPV4_SUBNET="172.30.0.0/16"
DOCKER_IPV4_GATEWAY="172.30.0.1"

# IPv6 subnet and gateway for the same Docker network.
# Docker must support IPv6 networking on the host.
DOCKER_IPV6_SUBNET="fd00:172:30::/64"
DOCKER_IPV6_GATEWAY="fd00:172:30::1"




# ----------------------------------------------------------------------------
# 3. MariaDB database and credentials
# ----------------------------------------------------------------------------

# Database and application account created by mariadb/first_start.sh.
DB_NAME="nc_cloud"
DB_USER="nc_cloud"
DB_PASSWORD="nc_cloud"

# MariaDB root password used by the initial database setup script and container.
DB_ROOT_PASSWORD="root"




# ----------------------------------------------------------------------------
# 4. Custom Nextcloud PHP-FPM image
# ----------------------------------------------------------------------------

# Local image name and tag. Together they form: NC_IMAGE_NAME:NC_IMAGE_VERSION
NC_IMAGE_NAME="nc_cloud"
NC_IMAGE_VERSION="v1.2.0"

# Install Node.js 26 in addition to the packages from the Dockerfile.
# true  = install Node.js 26 during image build
# false = do not add Node.js 26
INSTALL_NODE26="true"




# ----------------------------------------------------------------------------
# 5. Nextcloud first installation
# ----------------------------------------------------------------------------

# Database connection used by Nextcloud's autoconfig.php.
# NC_DB_HOST is the Docker DNS service/container name and MariaDB port.
NC_DB_HOST="nc_mariadb:3306"
NC_DB_TYPE="mysql"
NC_DB_PREFIX="oc_"

# Data directory INSIDE the Nextcloud container.
# The host directory /docker/nc/nextcloud/data is mounted there by Compose.
NC_DATA_DIR="/var/www/data"

# Initial Nextcloud administrator account created by the web installer.
# Change the example password before the first installation.
NC_ADMIN_USER="admin"
NC_ADMIN_PASSWORD="Admin#2026"

# Nextcloud server identifier. Keep stable for an existing installation.
NC_SERVER_ID="5"




# ----------------------------------------------------------------------------
# 6. Nextcloud mail (SMTP)
# ----------------------------------------------------------------------------

# Mail transport. Usually: smtp
NC_MAIL_MODE="smtp"

# Sender address parts. The resulting address is NC_MAIL_FROM@NC_MAIL_DOMAIN.
NC_MAIL_FROM="cloud"
NC_MAIL_DOMAIN="lokal.de"

# SMTP server and port. Common ports: 465 (implicit TLS), 587 (STARTTLS).
NC_MAIL_HOST="mail.lokal.de"
NC_MAIL_PORT="465"

# SMTP authentication: true or false.
NC_MAIL_AUTH="true"
NC_MAIL_USER="cloud@lokal.de"
NC_MAIL_PASSWORD="passwort"

# Encryption mode used by Nextcloud. Common values: ssl, tls, or empty.
NC_MAIL_SECURE="ssl"




# ----------------------------------------------------------------------------
# 7. Nextcloud language and basic options
# ----------------------------------------------------------------------------

# Default language of the Nextcloud user interface (locale format).
# Examples: de_DE, en_GB, en_US, fr_FR.
NC_DEFAULT_LANGUAGE="de_DE"

# Show the Nextcloud knowledge base/help links: true or false.
NC_KNOWLEDGEBASE_ENABLED="false"

# Enable WebAuthn authentication support: true or false.
NC_WEBAUTHN_ENABLED="false"

# Password recovery link. Use a value supported by your Nextcloud version.
# Common settings include: disabled or email.
NC_LOST_PASSWORD_LINK="disabled"

# Default country code for phone numbers (ISO 3166-1 alpha-2).
# Examples: DE, AT, CH, GB, US.
NC_DEFAULT_PHONE_REGION="DE"







# ----------------------------------------------------------------------------
# 8. Euro Office
# ----------------------------------------------------------------------------

# Euro-Office – gemeinsamer JWT-Schlüssel
# Muss auf Document Server und Nextcloud-App identisch sein.
# Mindestens 32 Zeichen.
EUROOFFICE_JWT_SECRET="98df8euHz65FTgtrED6543EDFjNMu7ZHG6tKJUH6"



