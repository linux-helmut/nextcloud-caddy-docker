FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# PHP 8.5 Repository (Sury)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
 && curl -fsSLo /tmp/debsuryorg-archive-keyring.deb \
    https://packages.sury.org/debsuryorg-archive-keyring.deb \
 && apt-get install -y --no-install-recommends \
    /tmp/debsuryorg-archive-keyring.deb \
 && rm -f /tmp/debsuryorg-archive-keyring.deb \
 && printf '%s\n' \
    'Types: deb' \
    'URIs: https://packages.sury.org/php/' \
    'Suites: trixie' \
    'Components: main' \
    'Signed-By: /usr/share/keyrings/debsuryorg-archive-keyring.gpg' \
    > /etc/apt/sources.list.d/php.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
    xz-utils \
    unzip \
    coreutils \
    php8.5-cli \
    php8.5-apcu \
    php8.5-bcmath \
    php8.5-bz2 \
    php8.5-curl \
    php8.5-gd \
    php8.5-gmp \
    php8.5-fpm \
    php8.5-igbinary \
    php8.5-imagick \
    php8.5-intl \
    php8.5-mbstring \
    php8.5-mysql \
    php8.5-redis \
    php8.5-soap \
    php8.5-xml \
    php8.5-zip \
    libmagickcore-7.q16-10-extra \
    imagemagick \
    ffmpeg \
    iproute2 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*


# Optional: Node.js 26.x installieren
ARG INSTALL_NODE26=false

RUN if [ "$INSTALL_NODE26" = "true" ]; then \
    set -eu; \
    curl -fsSL https://nodejs.org/dist/index.json -o /tmp/node-index.json; \
    NODE_VERSION=$(grep -m1 -E '"version"[[:space:]]*:[[:space:]]*"v26\.' /tmp/node-index.json \
        | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'); \
    NODE_FILE="node-${NODE_VERSION}-linux-x64.tar.xz"; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/${NODE_VERSION}/${NODE_FILE}"; \
    curl -fsSLO "https://nodejs.org/dist/${NODE_VERSION}/SHASUMS256.txt"; \
    grep " ${NODE_FILE}$" SHASUMS256.txt | sha256sum -c -; \
    tar -xJf "${NODE_FILE}" -C /usr/local --strip-components=1; \
    rm -f "${NODE_FILE}" SHASUMS256.txt node-index.json; \
    fi


COPY example/run.sh /run.sh
RUN chmod +x /run.sh

CMD ["/run.sh"]


