{
        servers {
                protocols h1 h2 h3
                trusted_proxies static private_ranges 172.30.0.0/16
        }
}

nextcloud.domain.de {
        tls internal
        root * /var/www/nextcloud
        encode gzip zstd
        handle_path /push/* {
                reverse_proxy http://nextcloud:7867
        }
        header {
                Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                -Server
        }

        redir /.well-known/carddav /remote.php/dav/ 301
        redir /.well-known/caldav /remote.php/dav/ 301
        redir /.well-known/webfinger /index.php/.well-known/webfinger 301
        redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301

        @forbidden {
                path /.htaccess
                path /.git*
                path /data/*
                path /config/*
                path /db_structure
                path /README*
                path /3rdparty/*
                path /lib/*
                path /templates/*
                path /occ
                path /console.php
                path /.xml
        }
        respond @forbidden 404
        php_fastcgi nextcloud:9000
        file_server
}

office.domain.de {
        tls internal
        @blocked path / /welcome* /example*
        respond @blocked 404
        encode gzip zstd
        reverse_proxy euro-office:80
}
